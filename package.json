{
  "name": "app-compliance-scanner",
  "version": "0.0.0",
  "private": true,
  "description": "Risk screening for websites. Not legal advice and not a compliance certificate.",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scan": "pnpm --filter @acs/scanner scan",
    "evaluate": "pnpm --filter @acs/rules evaluate",
    "api": "pnpm --filter @acs/api start",
    "synth": "pnpm --filter @acs/infra synth",
    "browsers": "pnpm --filter @acs/scanner install-browsers"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.8.0",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.61.1",
    "vitest": "^2.1.8"
  }
}
