# Copy this file to .env and fill in locally.
# Never commit secrets. This repo has no default credentials.

# Stage 5 (optional LLM). Leave empty to use the template fallback.
OPENAI_API_KEY=

# Local web (Stage 4). Next.js proxies to the API.
# ACS_API_URL=http://127.0.0.1:8787
# ACS_WEB_URL=http://127.0.0.1:3000

# Local API (Stage 3). Not required for CLI scan/evaluate.
# ACS_DATA_DIR=.data
# PORT=8787
# Test/local fixtures only. Never set this in production or CDK.
# ACS_ALLOW_PRIVATE_ADDRESSES=true

# AWS (Stage 3 deploy). Not required for local development.
AWS_REGION=
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TABLE_NAME=
BUCKET_NAME=
STATE_MACHINE_ARN=
